# Added to base-x86_64.config for the `nested` runtime class (ADR 0088). build.sh fails when
# an option below does not end up as written.

# The class runs Firecracker inside the guest: KVM on the host's own CPU vendor.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_AMD=y
CONFIG_KVM_INTEL=y

# The daemon's nftables rules (crates/briqyardd/src/netw/nft.rs, nft/siblings.rs).
# Tables of the inet and bridge families, and ARP matches in the bridge table.
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NF_TABLES_ARP=y
# `meta ibrname`, `meta obrname`
CONFIG_NFT_BRIDGE_META=y
# `masquerade`
CONFIG_NFT_MASQ=y
# `reject`, `reject with tcp reset`, in inet and bridge tables
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_BRIDGE_REJECT=y
# named `limit` objects found through a map
CONFIG_NFT_LIMIT=y
# `fib`, and the IPv4 and IPv6 halves the inet one needs
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
# conntrack state over netlink (`conntrack -L`, ct helpers)
CONFIG_NF_CT_NETLINK=y

# A server loads br_netfilter only when asked, and the daemon's rules assume it did not: a
# namespace's own traffic is bridged, and the inet forward chain (policy drop) must not see it.
# Built in, the bridge hands its frames to the IP hooks by default.
CONFIG_BRIDGE_NETFILTER=m

# OpenZFS is built against this kernel as a module. The base config keeps only the symbols
# its in-tree modules use (it has none), which would leave zfs.ko with unresolved symbols;
# modules unload for a reload after a failed load.
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_MODULE_UNLOAD=y

# 6.18.54-briqyard-nested: the directory the modules drive is mounted at.
CONFIG_LOCALVERSION="-briqyard-nested"
# CONFIG_LOCALVERSION_AUTO is not set
