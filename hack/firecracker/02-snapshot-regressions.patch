@@ -0,0 +1,121 @@
+// Copyright 2026 Firecracker authors. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use crate::device_manager::snapshot::SnapshotPrepareError;
+use crate::devices::virtio::block::device::BlockPrepareError;
+use crate::devices::virtio::block::virtio::snapshot_fault::{Fault, Stage};
+use crate::persist::{CreateSnapshotError, MicrovmStateError};
+use crate::rpc_interface::{RuntimeApiController, VmmAction, VmmActionError};
+use crate::vmm_config::instance_info::VmState;
+use crate::vmm_config::snapshot::{CreateSnapshotParams, SnapshotType};
+
+#[test]
+fn checked_snapshot_api_refuses_io_failure_before_output_publication() {
+    for pci in [false, true] {
+        for (engine, stage, visited) in [
+            (
+                FileEngineType::Sync,
+                Stage::SyncFlush,
+                vec![Stage::SyncFlush],
+            ),
+            (
+                FileEngineType::Sync,
+                Stage::SyncAll,
+                vec![Stage::SyncFlush, Stage::SyncAll],
+            ),
+            (
+                FileEngineType::Async,
+                Stage::AsyncDrain,
+                vec![Stage::AsyncDrain],
+            ),
+            (
+                FileEngineType::Async,
+                Stage::AsyncSyncAll,
+                vec![Stage::AsyncDrain, Stage::AsyncSyncAll],
+            ),
+            (
+                FileEngineType::Async,
+                Stage::AsyncCompletion,
+                vec![
+                    Stage::AsyncDrain,
+                    Stage::AsyncSyncAll,
+                    Stage::AsyncCompletion,
+                ],
+            ),
+        ] {
+            for precreated in [false, true] {
+                let (mut vmm, _files) = fixture(pci, engine, true);
+                vmm.instance_info.state = VmState::Paused;
+                let vmm = Arc::new(Mutex::new(vmm));
+                let mut runtime = RuntimeApiController::new(vmm.clone());
+                let mut events = crate::EventManager::new().unwrap();
+                let mut state = TempFile::new().unwrap();
+                let mut memory = TempFile::new().unwrap();
+                let state_path = state.as_path().to_owned();
+                let memory_path = memory.as_path().to_owned();
+                if precreated {
+                    std::fs::write(&state_path, b"unchanged state").unwrap();
+                    std::fs::write(&memory_path, b"unchanged memory").unwrap();
+                } else {
+                    state.remove().unwrap();
+                    memory.remove().unwrap();
+                }
+                let scope = Fault::at(Some(stage));
+                let result = runtime.handle_request(
+                    VmmAction::CreateSnapshot(CreateSnapshotParams {
+                        snapshot_type: SnapshotType::Full,
+                        snapshot_path: state_path.clone(),
+                        mem_file_path: memory_path.clone(),
+                        sync_snapshot_files: true,
+                    }),
+                    &mut events,
+                );
+                assert!(
+                    matches!(
+                        &result,
+                        Err(VmmActionError::CreateSnapshot(
+                            CreateSnapshotError::MicrovmState(MicrovmStateError::PrepareDevices(
+                                SnapshotPrepareError::Block(BlockPrepareError::Io(_))
+                            ))
+                        ))
+                    ),
+                    "unexpected snapshot result: {result:?}"
+                );
+                assert_eq!(scope.visited(), visited);
+                assert_eq!(vmm.lock().unwrap().instance_info.state, VmState::Paused);
+                if precreated {
+                    assert_eq!(std::fs::read(&state_path).unwrap(), b"unchanged state");
+                    assert_eq!(std::fs::read(&memory_path).unwrap(), b"unchanged memory");
+                } else {
+                    assert!(!state_path.exists());
+                    assert!(!memory_path.exists());
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn checked_snapshot_refuses_unsupported_backend_on_both_buses() {
+    for pci in [false, true] {
+        let (mut vmm, _files) = fixture(pci, FileEngineType::Sync, false);
+        vmm.device_manager
+            .with_virtio_device::<Block, _, _>("root", |block| {
+                *block = super::block::unsupported();
+            })
+            .unwrap();
+        assert!(matches!(
+            vmm.device_manager.try_save_for_snapshot(),
+            Err(SnapshotPrepareError::Block(
+                BlockPrepareError::UnsupportedBackend
+            ))
+        ));
+        // The normal VMM eligibility check also rejects this backend before capture.
+        let info = crate::persist::VmInfo::from(&vmm);
+        assert!(matches!(
+            vmm.save_state(&info),
+            Err(MicrovmStateError::NotAllowed(_))
+        ));
+    }
+}
