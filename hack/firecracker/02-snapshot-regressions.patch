+// Copyright 2026 Firecracker authors. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+use std::sync::{Arc, Mutex};
+
+use vmm_sys_util::tempfile::TempFile;
+
+use crate::Vmm;
+use crate::builder::tests::{
+    CustomBlockConfig, default_kernel_cmdline, default_vmm, default_vmm_with_pci,
+    insert_block_devices,
+};
+use crate::devices::virtio::block::CacheType;
+use crate::devices::virtio::block::device::Block;
+use crate::devices::virtio::block::virtio::FileEngine;
+use crate::devices::virtio::block::virtio::device::FileEngineType;
+use crate::devices::virtio::device::VirtioDevice;
+use crate::devices::virtio::test_utils::{VirtQueue, default_interrupt};
+use crate::vstate::memory::GuestAddress;
+
+#[path = "api.rs"]
+mod api;
+#[path = "block.rs"]
+mod block;
+
+fn fixture(pci: bool, engine: FileEngineType, activated: bool) -> (Vmm, Vec<TempFile>) {
+    fixture_drives(pci, engine, activated, 1)
+}
+
+fn fixture_drives(
+    pci: bool,
+    engine: FileEngineType,
+    activated: bool,
+    count: usize,
+) -> (Vmm, Vec<TempFile>) {
+    let ids = ["root", "data"];
+    let mut vmm = if pci {
+        default_vmm_with_pci()
+    } else {
+        default_vmm()
+    };
+    let mut events = crate::EventManager::new().unwrap();
+    let files = insert_block_devices(
+        &mut vmm,
+        &mut default_kernel_cmdline(),
+        &mut events,
+        ids[..count]
+            .iter()
+            .map(|id| {
+                CustomBlockConfig::new(
+                    (*id).into(),
+                    *id == "root",
+                    None,
+                    false,
+                    CacheType::Writeback,
+                )
+            })
+            .collect(),
+    );
+    let mem = vmm.vm.as_kvm().unwrap().guest_memory().clone();
+    for (index, id) in ids[..count].iter().enumerate() {
+        vmm.device_manager
+            .with_virtio_device::<Block, _, _>(id, |block| {
+                let Block::Virtio(block) = block else {
+                    unreachable!()
+                };
+                block.disk.file_engine = FileEngine::from_file(
+                    block.disk.file_engine.file().try_clone().unwrap(),
+                    engine,
+                )
+                .unwrap();
+                if activated {
+                    let queue = VirtQueue::new(
+                        GuestAddress(u64::try_from(index).unwrap() * 0x1000),
+                        &mem,
+                        16,
+                    );
+                    block.queues[0] = queue.create_queue();
+                    block.activate(mem.clone(), default_interrupt()).unwrap();
+                }
+            })
+            .unwrap();
+    }
+    (vmm, files)
+}
