+// Copyright 2026 Firecracker authors. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+use std::io::Cursor;
+
+use vmm::device_manager::snapshot::SnapshotPrepareError;
+use vmm::devices::virtio::block::device::BlockPrepareError;
+use vmm::persist::{CreateSnapshotError, MicrovmStateError};
+use vmm::rpc_interface::VmmActionError;
+
+use super::ParsedRequest;
+
+#[test]
+fn checked_preparation_failure_is_http_error_not_snapshot_success() {
+    let error = VmmActionError::CreateSnapshot(CreateSnapshotError::MicrovmState(
+        MicrovmStateError::PrepareDevices(SnapshotPrepareError::Block(
+            BlockPrepareError::UnsupportedBackend,
+        )),
+    ));
+    let response = ParsedRequest::convert_to_response(&Err(error));
+    let mut wire = Cursor::new(Vec::new());
+    response.write_all(&mut wire).unwrap();
+    assert!(wire.get_ref().starts_with(b"HTTP/1.1 400 "));
+}
