@@ -0,0 +1,210 @@
+// Copyright 2026 Firecracker authors. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+use std::fs::File;
+use std::os::fd::OwnedFd;
+use std::os::unix::net::UnixStream;
+
+use super::*;
+use crate::device_manager::snapshot::SnapshotPrepareError;
+use crate::devices::virtio::block::device::BlockPrepareError;
+use crate::devices::virtio::block::virtio::snapshot_fault::{Fault, Stage};
+use crate::devices::virtio::block::virtio::test_utils::default_block;
+use crate::devices::virtio::test_utils::default_mem;
+use crate::snapshot::Persist;
+
+fn active(engine: FileEngineType) -> Block {
+    let mut block = default_block(engine);
+    let mem = default_mem();
+    let queue = VirtQueue::new(GuestAddress(0), &mem, 16);
+    block.queues[0] = queue.create_queue();
+    block.activate(mem, default_interrupt()).unwrap();
+    Block::Virtio(block)
+}
+
+#[test]
+fn checked_inactive_has_no_io_and_preserves_serialized_state() {
+    for pci in [false, true] {
+        for engine in [FileEngineType::Sync, FileEngineType::Async] {
+            let (vmm, _files) = fixture(pci, engine, false);
+            let scope = Fault::at(Some(Stage::SyncFlush));
+            let checked = vmm.device_manager.try_save_for_snapshot().unwrap();
+            let legacy = vmm.device_manager.save();
+            assert_eq!(
+                serde_json::to_value(checked).unwrap(),
+                serde_json::to_value(legacy).unwrap()
+            );
+            assert_eq!(
+                scope.visited(),
+                [Stage::TransportState, Stage::TransportState]
+            );
+        }
+    }
+}
+
+#[test]
+fn checked_prepares_once_without_unchecked_second_pass() {
+    for pci in [false, true] {
+        for (engine, expected) in [
+            (
+                FileEngineType::Sync,
+                vec![Stage::SyncFlush, Stage::SyncAll, Stage::TransportState],
+            ),
+            (
+                FileEngineType::Async,
+                vec![
+                    Stage::AsyncDrain,
+                    Stage::AsyncSyncAll,
+                    Stage::AsyncCompletion,
+                    Stage::TransportState,
+                ],
+            ),
+        ] {
+            let (vmm, _files) = fixture(pci, engine, true);
+            let scope = Fault::at(None);
+            vmm.device_manager.try_save_for_snapshot().unwrap();
+            assert_eq!(scope.visited(), expected);
+        }
+    }
+}
+
+#[test]
+fn checked_propagates_real_sync_syscall_failure() {
+    // A socket FD accepts File::flush but cannot be fsynced. No mocked Result here.
+    let mut block = active(FileEngineType::Sync);
+    let (socket, _peer) = UnixStream::pair().unwrap();
+    let file = File::from(OwnedFd::from(socket));
+    let Block::Virtio(virtio) = &mut block else {
+        unreachable!()
+    };
+    virtio.disk.file_engine = FileEngine::from_file(file, FileEngineType::Sync).unwrap();
+    assert!(matches!(
+        block.prepare_snapshot_checked(),
+        Err(BlockPrepareError::Io(_))
+    ));
+}
+
+#[test]
+fn drain_failure_cannot_reach_sync_or_completion() {
+    let mut block = active(FileEngineType::Async);
+    let scope = Fault::at(Some(Stage::AsyncDrain));
+    assert!(matches!(
+        block.prepare_snapshot_checked(),
+        Err(BlockPrepareError::Io(_))
+    ));
+    assert_eq!(scope.visited(), [Stage::AsyncDrain]);
+}
+
+#[test]
+fn checked_refuses_unhandled_block_implementation() {
+    let mut block = unsupported();
+    assert!(matches!(
+        super::super::prepare_device(&mut block),
+        Err(SnapshotPrepareError::Block(
+            BlockPrepareError::UnsupportedBackend
+        ))
+    ));
+}
+
+pub(super) fn unsupported() -> Block {
+    use crate::devices::virtio::block::vhost_user::device::VhostUserBlock;
+    use crate::devices::virtio::device::DeviceState;
+    use crate::devices::virtio::queue::Queue;
+    use crate::devices::virtio::vhost_user::{VhostUserHandleBackend, VhostUserHandleImpl};
+    use crate::devices::virtio::vhost_user_metrics::VhostUserMetricsPerDevice;
+    use vhost::vhost_user::Frontend;
+    use vmm_sys_util::eventfd::EventFd;
+
+    // Construct an unnegotiated unsupported backend over a local socket pair.
+    // Checked preparation must refuse it without sending any backend messages.
+    let (socket, _peer) = UnixStream::pair().unwrap();
+    Block::VhostUser(VhostUserBlock {
+        avail_features: 0,
+        acked_features: 0,
+        config_space: vec![],
+        activate_evt: EventFd::new(libc::EFD_NONBLOCK).unwrap(),
+        queues: vec![Queue::new(256)],
+        queue_evts: [EventFd::new(libc::EFD_NONBLOCK).unwrap()],
+        device_state: DeviceState::Inactive,
+        id: "root".into(),
+        partuuid: None,
+        cache_type: CacheType::Writeback,
+        root_device: true,
+        read_only: false,
+        vu_handle: VhostUserHandleImpl {
+            vu: <Frontend as VhostUserHandleBackend>::from_stream(socket, 1),
+            socket_path: String::new(),
+        },
+        vu_acked_protocol_features: 0,
+        metrics: VhostUserMetricsPerDevice::alloc("checked-unsupported".into()),
+    })
+}
+
+#[test]
+fn checked_sync_errors_are_returned_and_inactive_is_no_io() {
+    for (stage, expected) in [
+        (Stage::SyncFlush, vec![Stage::SyncFlush]),
+        (Stage::SyncAll, vec![Stage::SyncFlush, Stage::SyncAll]),
+    ] {
+        let mut block = active(FileEngineType::Sync);
+        let scope = Fault::at(Some(stage));
+        assert!(matches!(
+            block.prepare_snapshot_checked(),
+            Err(BlockPrepareError::Io(_))
+        ));
+        assert_eq!(scope.visited(), expected);
+    }
+    let mut block = Block::Virtio(default_block(FileEngineType::Sync));
+    let scope = Fault::at(Some(Stage::SyncFlush));
+    block.prepare_snapshot_checked().unwrap();
+    assert!(scope.visited().is_empty());
+}
+
+#[test]
+fn checked_async_errors_are_returned_before_completion_can_succeed() {
+    for (stage, expected) in [
+        (Stage::AsyncDrain, vec![Stage::AsyncDrain]),
+        (
+            Stage::AsyncSyncAll,
+            vec![Stage::AsyncDrain, Stage::AsyncSyncAll],
+        ),
+        (
+            Stage::AsyncCompletion,
+            vec![
+                Stage::AsyncDrain,
+                Stage::AsyncSyncAll,
+                Stage::AsyncCompletion,
+            ],
+        ),
+    ] {
+        let mut block = active(FileEngineType::Async);
+        let scope = Fault::at(Some(stage));
+        assert!(matches!(
+            block.prepare_snapshot_checked(),
+            Err(BlockPrepareError::Io(_))
+        ));
+        assert_eq!(scope.visited(), expected);
+    }
+}
+
+#[test]
+fn later_device_failure_precedes_every_transport_and_kvm_save() {
+    for pci in [false, true] {
+        let (mut vmm, _files) = fixture_drives(pci, FileEngineType::Sync, true, 2);
+        let info = crate::persist::VmInfo::from(&vmm);
+        let scope = Fault::nth(Some(Stage::SyncAll), 2);
+        assert!(matches!(
+            vmm.save_state(&info),
+            Err(crate::persist::MicrovmStateError::PrepareDevices(_))
+        ));
+        assert_eq!(
+            scope.visited(),
+            [
+                Stage::SyncFlush,
+                Stage::SyncAll,
+                Stage::SyncFlush,
+                Stage::SyncAll
+            ]
+        );
+    }
+}
