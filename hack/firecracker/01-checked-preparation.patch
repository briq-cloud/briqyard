@@ -0,0 +1,83 @@
+// Copyright 2026 Firecracker authors. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Thread-local fault scope: no environment mutation or cross-test fault leakage.
+
+use std::cell::RefCell;
+use std::io;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Stage {
+    SyncFlush,
+    SyncAll,
+    AsyncDrain,
+    AsyncSyncAll,
+    AsyncCompletion,
+    TransportState,
+    KvmState,
+}
+
+#[derive(Default)]
+struct State {
+    fail: Option<Stage>,
+    visited: Vec<Stage>,
+    fail_nth: usize,
+}
+
+thread_local! {
+    static STATE: RefCell<Option<State>> = const { RefCell::new(None) };
+}
+
+#[derive(Debug)]
+pub(crate) struct Fault;
+
+impl Fault {
+    pub(crate) fn at(fail: Option<Stage>) -> Self {
+        Self::nth(fail, 1)
+    }
+
+    pub(crate) fn nth(fail: Option<Stage>, fail_nth: usize) -> Self {
+        assert!(fail_nth > 0);
+        STATE.with_borrow_mut(|state| {
+            assert!(state.is_none(), "nested snapshot fault scope");
+            *state = Some(State {
+                fail,
+                visited: Vec::new(),
+                fail_nth,
+            });
+        });
+        Self
+    }
+
+    pub(crate) fn visited(&self) -> Vec<Stage> {
+        STATE.with_borrow(|state| state.as_ref().unwrap().visited.clone())
+    }
+}
+
+impl Drop for Fault {
+    fn drop(&mut self) {
+        STATE.with_borrow_mut(|state| *state = None);
+    }
+}
+
+pub(crate) fn check(stage: Stage) -> io::Result<()> {
+    STATE.with_borrow_mut(|state| {
+        if let Some(state) = state {
+            state.visited.push(stage);
+            if state.fail == Some(stage)
+                && state.visited.iter().filter(|seen| **seen == stage).count() == state.fail_nth
+            {
+                return Err(io::Error::from_raw_os_error(libc::EIO));
+            }
+        }
+        Ok(())
+    })
+}
+
+pub(crate) fn observe(stage: Stage) {
+    STATE.with_borrow_mut(|state| {
+        if let Some(state) = state {
+            state.visited.push(stage);
+        }
+    });
+}
