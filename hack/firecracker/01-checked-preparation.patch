+// Copyright 2026 Firecracker authors. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Checked preparation before any snapshot transport or VM state is captured.
+
+use super::mmio::MMIOVirtioDevices;
+use super::pci_mngr::{PciDevices, PciDevicesState};
+use super::persist::DeviceStates;
+use super::{DeviceManager, DevicesState, VirtioDevices, VirtioDevicesState};
+use crate::devices::virtio::block::device::{Block, BlockPrepareError};
+use crate::devices::virtio::device::{VirtioDevice, VirtioDeviceType};
+use crate::snapshot::Persist;
+
+/// A failure before checked snapshot serialization can begin.
+#[derive(Debug, thiserror::Error, displaydoc::Display)]
+pub enum SnapshotPrepareError {
+    /// Block preparation failed: {0}
+    Block(#[from] BlockPrepareError),
+    /// Block device implementation is not supported by checked preparation.
+    UnsupportedBlock,
+}
+
+fn prepare_device(device: &mut dyn VirtioDevice) -> Result<(), SnapshotPrepareError> {
+    match device.device_type() {
+        VirtioDeviceType::Block => device
+            .as_mut_any()
+            .downcast_mut::<Block>()
+            .ok_or(SnapshotPrepareError::UnsupportedBlock)?
+            .prepare_snapshot_checked()?,
+        VirtioDeviceType::Balloon
+        | VirtioDeviceType::Net
+        | VirtioDeviceType::Vsock
+        | VirtioDeviceType::Rng
+        | VirtioDeviceType::Pmem
+        | VirtioDeviceType::Mem => device.prepare_save(),
+    }
+    Ok(())
+}
+
+impl MMIOVirtioDevices {
+    /// Prepare every device before saving any transport state.
+    pub fn try_save_for_snapshot(&self) -> Result<DeviceStates, SnapshotPrepareError> {
+        self.for_each_virtio_mmio_device(|_, _, device| {
+            let transport = device.inner.lock().expect("Poisoned lock");
+            let mut device = transport.locked_device();
+            prepare_device(&mut *device)
+        })?;
+        // Do not call Persist::save here: it would prepare devices a second time.
+        Ok(self.save_with_prepare(false))
+    }
+}
+
+impl PciDevices {
+    /// Prepare every device before saving any transport state.
+    pub fn try_save_for_snapshot(&self) -> Result<PciDevicesState, SnapshotPrepareError> {
+        let mut result = Ok(());
+        self.for_each_virtio_device_mut(|_, device| {
+            if result.is_ok() {
+                result = prepare_device(device);
+            }
+        });
+        result?;
+        Ok(self.save_with_prepare(false))
+    }
+}
+
+impl DeviceManager {
+    /// Complete checked preparation before transport, KVM, state or RAM capture.
+    pub fn try_save_for_snapshot(&self) -> Result<DevicesState, SnapshotPrepareError> {
+        let virtio_state = match &self.virtio_devices {
+            VirtioDevices::Mmio(devices) => {
+                VirtioDevicesState::Mmio(devices.try_save_for_snapshot()?)
+            }
+            VirtioDevices::Pci(devices) => {
+                VirtioDevicesState::Pci(devices.try_save_for_snapshot()?)
+            }
+        };
+        Ok(DevicesState {
+            virtio_state,
+            mmio_platform_state: self.mmio_platform_devices.save(),
+            acpi_state: self.acpi_devices.save(),
+            serial_state: self.serial_state(),
+        })
+    }
+}
